{
  "description": "Repository-level completion checks.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/readme-nudge.sh\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/.codex/hooks/readme-nudge.ps1\"",
            "timeout": 10,
            "statusMessage": "Checking README consistency"
          }
        ]
      }
    ]
  }
}
